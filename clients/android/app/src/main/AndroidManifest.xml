<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Requested at runtime (not just declared here) before PlayerActivity
         ever starts capturing; see its onMicEnable handling. Only ever
         actually opens the mic while the console has one powered on and
         sampling (Listener.onMicEnable), not just because a stream is
         connected. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- PlayerActivity holds a WifiManager.WifiLock for as long as the
         stream is being watched (see its own comment): Wi-Fi power-save
         packet batching, not any server-side cause, was the best-fitting
         explanation for a periodic decode backlog unaffected by any
         encoder-side change. Normal (non-runtime) permission, granted at
         install time. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- WifiLock.acquire() itself enforces this permission too, in
         addition to CHANGE_WIFI_STATE: missing it crashed
         PlayerActivity.onCreate() with a SecurityException the moment a
         stream was opened. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Needed for the menu's GET /status polling and discovery sweep
         (java.net.HttpURLConnection in MenuActivity), which, unlike the
         actual GBA stream itself (a raw NDK POSIX socket in
         cpp/jni_bridge.c), does go through the Java networking stack
         Android's Network Security Config restricts. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Finlink"
        android:usesCleartextTraffic="true">
        <!-- Menu and Settings deliberately have no screenOrientation: they
             should follow whichever way the device is actually held.
             configChanges is still declared so rotating doesn't recreate
             the Activity (and lose in-flight state like a discovered-server
             list or lobby search results); Compose still recomposes for the
             new size/configuration regardless, since nothing here is
             orientation-specific. -->
        <activity
            android:name=".MenuActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".KeyBindingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".AntialiasingActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".LanguageActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".VideoModeActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- PlayerActivity stays landscape-locked: the GBA stream itself
             is a fixed wide aspect ratio, unlike the menu/settings forms. -->
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- Launched only from PlayerActivity, landscape-locked to match it.
             The stream stays connected in the background while this is on
             top. -->
        <activity
            android:name=".TextInputActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
