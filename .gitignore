.claude/
build/

# Android
clients/android/.gradle/
clients/android/.idea/
clients/android/local.properties
clients/android/*/build/
clients/android/*/.cxx/
clients/android/*.iml

# NDS -- classic devkitARM Makefile build (see clients/nds/README.md),
# puts final .elf/.nds directly in the source tree instead of a build/
# subdir like the other three clients' CMake builds.
clients/nds/arm7/*.elf
clients/nds/arm9/*.elf
clients/nds/*.nds

# 3DS -- CIA build tools (fetched by cia/fetch_tools.sh, see clients/3ds/CMakeLists.txt)
clients/3ds/cia/tools/

# Switch -- NSP build tools (fetched/built by nsp/build_hacbrewpack.sh, see clients/switch/CMakeLists.txt)
clients/switch/nsp/tools/

# Web -- emsdk toolchain (fetched by build_wasm.sh, see clients/web/README.md)
# and its intermediate unison_core wasm build dir; only unison_core.js
# itself is committed (a build artifact deliberately treated as source, see
# build_wasm.sh's own comment). Previously undocumented here despite
# build_wasm.sh already claiming ".gitignore excludes it" -- fixed while
# touching this file for the video-mode negotiation feature.
clients/web/emsdk/
clients/web/unison_core_wasm/

# Web -- Playwright (overlay.spec.mjs): npm packages fetched from
# package.json/package-lock.json (both committed), Chromium binary fetched
# by `npx playwright install`, and the two dirs it writes its own run
# output to.
clients/web/node_modules/
clients/web/test-results/
clients/web/playwright-report/

# Python bytecode cache (tools/*.py)
__pycache__/

# iOS -- Xcode project generated by XcodeGen (clients/ios/project.yml is
# the committed source of truth, see clients/ios/README.md) plus normal
# Xcode/SPM build byproducts. Can't be produced or opened outside a real
# Mac, so nothing here is exercised by local development on this machine.
clients/ios/*.xcodeproj/
clients/ios/DerivedData/
clients/ios/.build/
clients/ios/*.xcworkspace/
