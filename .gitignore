.claude/
build/

# Android
clients/android/.gradle/
clients/android/.idea/
clients/android/local.properties
clients/android/*/build/
clients/android/*/.cxx/
clients/android/*.iml

# NDS -- classic devkitARM Makefile build (see clients/nds/README.md),
# puts final .elf/.nds directly in the source tree instead of a build/
# subdir like the other three clients' CMake builds.
clients/nds/arm7/*.elf
clients/nds/arm9/*.elf
clients/nds/*.nds

# 3DS -- CIA build tools (fetched by cia/fetch_tools.sh, see clients/3ds/CMakeLists.txt)
clients/3ds/cia/tools/

# Switch -- NSP build tools (fetched/built by nsp/build_hacbrewpack.sh, see clients/switch/CMakeLists.txt)
clients/switch/nsp/tools/
